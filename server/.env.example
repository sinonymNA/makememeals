PORT=3001
CLIENT_URL=http://localhost:5173

# Railway PostgreSQL — copy from Railway dashboard > your Postgres service > Connect tab
DATABASE_URL=postgresql://postgres:password@host.railway.internal:5432/railway

# Anthropic — platform.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Clerk — dashboard.clerk.com > API Keys
CLERK_SECRET_KEY=sk_test_...

# Stripe — dashboard.stripe.com > Developers > API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — resend.com > API Keys (optional, emails no-op without it)
RESEND_API_KEY=

# MMM Shop
SHOP_DISCOUNT_FREE_CODE=MMMFREE10
