# ── AI ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Database (Postgres / Supabase / Railway) ─────────────────────────────
DATABASE_URL=

# ── Auth (Clerk) ─────────────────────────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=           # also set in client .env as VITE_CLERK_PUBLISHABLE_KEY

# ── Payments (Stripe) ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=          # also set in client .env as VITE_STRIPE_PUBLISHABLE_KEY (shop checkout)
STRIPE_WEBHOOK_SECRET=           # from Stripe Dashboard → Webhooks (shared by subscription + shop webhooks)
STRIPE_PRICE_ID_MONTHLY=         # $9.99/month recurring price ID
STRIPE_PRICE_ID_ANNUAL=          # $79.99/year recurring price ID

# ── Images (Pexels) ──────────────────────────────────────────────────────
PEXELS_API_KEY=                  # free at pexels.com/api — falls back to curated Unsplash CDN if missing

# ── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=                  # optional — for welcome/cancellation/shop emails

# ── Shop ─────────────────────────────────────────────────────────────────
SHOP_DISCOUNT_FREE_CODE=MMMFREE10
SHOP_DISCOUNT_PRO_CODE=MMMFREE25
SHOP_DISCOUNT_FREE_PERCENT=10
SHOP_DISCOUNT_PRO_PERCENT=25

# ── Admin ────────────────────────────────────────────────────────────────
ADMIN_API_KEY=                   # any strong secret — used for GET /api/admin/stats
ADMIN_EMAIL=                     # for future new-order notifications

# ── App ──────────────────────────────────────────────────────────────────
CLIENT_URL=https://yourdomain.com
PORT=3001
