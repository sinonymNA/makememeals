# ── AI ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Database (Postgres / Supabase / Railway) ─────────────────────────────
DATABASE_URL=

# ── Auth (Clerk) ─────────────────────────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=           # also set in client .env as VITE_CLERK_PUBLISHABLE_KEY

# ── Payments (Stripe) ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=          # not currently used server-side; set in client if needed
STRIPE_WEBHOOK_SECRET=           # from Stripe Dashboard → Webhooks
STRIPE_PRICE_ID_MONTHLY=         # $9.99/month recurring price ID
STRIPE_PRICE_ID_ANNUAL=          # $79.99/year recurring price ID

# ── Images (Pexels) ──────────────────────────────────────────────────────
PEXELS_API_KEY=                  # free at pexels.com/api — falls back to curated Unsplash CDN if missing

# ── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=                  # optional — for welcome/cancellation emails

# ── Admin ────────────────────────────────────────────────────────────────
ADMIN_API_KEY=                   # any strong secret — used for GET /api/admin/stats

# ── App ──────────────────────────────────────────────────────────────────
CLIENT_URL=https://yourdomain.com
PORT=3001
